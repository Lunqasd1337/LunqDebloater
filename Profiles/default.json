{
  "Name": "Default",
  "Description": "Умеренная очистка: убирает рекламные и редко нужные приложения, телеметрию и ИИ-функции, не трогая Store, winget, Терминал, Фотографии, Калькулятор и Блокнот.",

  "Appx": {
    "Remove": [
      "Clipchamp.Clipchamp",
      "Microsoft.549981C3F5F10",
      "Microsoft.BingNews",
      "Microsoft.BingSearch",
      "Microsoft.BingWeather",
      "Microsoft.Copilot",
      "Microsoft.GamingApp",
      "Microsoft.GetHelp",
      "Microsoft.Getstarted",
      "Microsoft.MicrosoftOfficeHub",
      "Microsoft.MicrosoftSolitaireCollection",
      "Microsoft.MicrosoftStickyNotes",
      "Microsoft.OutlookForWindows",
      "Microsoft.People",
      "Microsoft.PowerAutomateDesktop",
      "Microsoft.Todos",
      "Microsoft.Windows.DevHome",
      "Microsoft.WindowsAlarms",
      "Microsoft.WindowsFeedbackHub",
      "Microsoft.WindowsMaps",
      "Microsoft.WindowsSoundRecorder",
      "Microsoft.Xbox.TCUI",
      "Microsoft.XboxGamingOverlay",
      "Microsoft.XboxIdentityProvider",
      "Microsoft.XboxSpeechToTextOverlay",
      "Microsoft.YourPhone",
      "Microsoft.ZuneMusic",
      "Microsoft.ZuneVideo",
      "MicrosoftCorporationII.MicrosoftFamily",
      "MicrosoftCorporationII.QuickAssist",
      "MicrosoftTeams",
      "MSTeams"
    ]
  },

  "Capabilities": {
    "Remove": [
      "App.StepsRecorder*",
      "App.Support.QuickAssist*",
      "Browser.InternetExplorer*",
      "MathRecognizer*",
      "Media.WindowsMediaPlayer*",
      "Microsoft.Windows.PowerShell.ISE*",
      "Microsoft.Windows.WordPad*"
    ]
  },

  "Features": {
    "RemovePayload": false,
    "Disable": [
      "Recall",
      "WorkFolders-Client",
      "Printing-XPSServices-Features",
      "MicrosoftWindowsPowerShellV2Root",
      "MicrosoftWindowsPowerShellV2"
    ]
  },

  "Packages": {
    "Remove": []
  },

  "Registry": [
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\DataCollection", "Name": "AllowTelemetry", "Type": "REG_DWORD", "Value": 0, "Description": "Минимальный уровень телеметрии" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\DataCollection", "Name": "DoNotShowFeedbackNotifications", "Type": "REG_DWORD", "Value": 1, "Description": "Не просить отзывы" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\AdvertisingInfo", "Name": "DisabledByGroupPolicy", "Type": "REG_DWORD", "Value": 1, "Description": "Отключить рекламный идентификатор" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\CloudContent", "Name": "DisableWindowsConsumerFeatures", "Type": "REG_DWORD", "Value": 1, "Description": "Не устанавливать рекламные приложения автоматически" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\CloudContent", "Name": "DisableCloudOptimizedContent", "Type": "REG_DWORD", "Value": 1, "Description": "Отключить облачный контент в «Пуске»" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\WindowsCopilot", "Name": "TurnOffWindowsCopilot", "Type": "REG_DWORD", "Value": 1, "Description": "Отключить Copilot (для компьютера)" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\WindowsAI", "Name": "DisableAIDataAnalysis", "Type": "REG_DWORD", "Value": 1, "Description": "Отключить снимки Recall" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Dsh", "Name": "AllowNewsAndInterests", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить виджеты" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\Windows Search", "Name": "AllowCortana", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить Cortana" },
    { "Hive": "SOFTWARE", "Path": "Policies\\Microsoft\\Windows\\Windows Search", "Name": "ConnectedSearchUseWeb", "Type": "REG_DWORD", "Value": 0, "Description": "Не искать в интернете из поиска Windows" },
    { "Hive": "SOFTWARE", "Path": "Microsoft\\WindowsUpdate\\Orchestrator\\UScheduler_Oobe\\DevHomeUpdate", "Action": "DeleteKey", "Description": "Не доустанавливать Dev Home после установки" },
    { "Hive": "SOFTWARE", "Path": "Microsoft\\WindowsUpdate\\Orchestrator\\UScheduler_Oobe\\OutlookUpdate", "Action": "DeleteKey", "Description": "Не доустанавливать новый Outlook после установки" },

    { "Hive": "SYSTEM", "Path": "ControlSet001\\Services\\DiagTrack", "Name": "Start", "Type": "REG_DWORD", "Value": 4, "Description": "Отключить службу телеметрии DiagTrack" },
    { "Hive": "SYSTEM", "Path": "ControlSet001\\Services\\dmwappushservice", "Name": "Start", "Type": "REG_DWORD", "Value": 4, "Description": "Отключить службу маршрутизации push-сообщений WAP" },

    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "ContentDeliveryAllowed", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить доставку рекламного контента" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "SilentInstalledAppsEnabled", "Type": "REG_DWORD", "Value": 0, "Description": "Не устанавливать приложения без спроса" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "PreInstalledAppsEnabled", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить предустановленные рекламные приложения" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "OemPreInstalledAppsEnabled", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить приложения производителя" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "SystemPaneSuggestionsEnabled", "Type": "REG_DWORD", "Value": 0, "Description": "Убрать рекомендации в «Пуске»" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "SubscribedContent-338388Enabled", "Type": "REG_DWORD", "Value": 0, "Description": "Убрать советы в «Пуске»" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "SubscribedContent-338389Enabled", "Type": "REG_DWORD", "Value": 0, "Description": "Убрать советы и подсказки Windows" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "SubscribedContent-353694Enabled", "Type": "REG_DWORD", "Value": 0, "Description": "Убрать предложения в Параметрах" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "Name": "SubscribedContent-353696Enabled", "Type": "REG_DWORD", "Value": 0, "Description": "Убрать предложения в Параметрах" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "Name": "Enabled", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить рекламный идентификатор пользователя" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Search", "Name": "BingSearchEnabled", "Type": "REG_DWORD", "Value": 0, "Description": "Отключить Bing в поиске" },
    { "Hive": "DefaultUser", "Path": "Software\\Policies\\Microsoft\\Windows\\Explorer", "Name": "DisableSearchBoxSuggestions", "Type": "REG_DWORD", "Value": 1, "Description": "Отключить веб-подсказки в поиске «Пуска»" },
    { "Hive": "DefaultUser", "Path": "Software\\Policies\\Microsoft\\Windows\\WindowsCopilot", "Name": "TurnOffWindowsCopilot", "Type": "REG_DWORD", "Value": 1, "Description": "Отключить Copilot (для пользователя)" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "Name": "ShowCopilotButton", "Type": "REG_DWORD", "Value": 0, "Description": "Скрыть кнопку Copilot" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "Name": "TaskbarDa", "Type": "REG_DWORD", "Value": 0, "Description": "Скрыть виджеты на панели задач" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "Name": "TaskbarMn", "Type": "REG_DWORD", "Value": 0, "Description": "Скрыть чат на панели задач" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "Name": "HideFileExt", "Type": "REG_DWORD", "Value": 0, "Description": "Показывать расширения файлов" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "Name": "LaunchTo", "Type": "REG_DWORD", "Value": 1, "Description": "Открывать Проводник на «Этот компьютер»" },
    { "Hive": "DefaultUser", "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Run", "Name": "OneDriveSetup", "Action": "DeleteValue", "Description": "Не устанавливать OneDrive при первом входе" }
  ]
}
