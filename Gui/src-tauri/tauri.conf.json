{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LunqDebloater",
  "version": "1.10.0",
  "identifier": "com.lunqasd1337.lunqdebloater",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LunqDebloater",
        "width": 760,
        "height": 820,
        "minWidth": 560,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
